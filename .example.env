# Required

# MongoDB connection string. Matches the docker run command in the README.
MONGO_DB_URI=mongodb://mongo:mongo@localhost:27017/pe_prod?authSource=admin

# JWT signing secret for auth cookies. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional

# Base URL used in transactional email links. Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email. Without a key, email sending fails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Airtable contact-form forwarding
AIRTABLE_API_KEY=

# Brevo newsletter subscriptions
BREVO_API_KEY=

# Google Analytics measurement ID
NEXT_PUBLIC_GA_ID=

# Client-visible environment flag. Defaults to production
NEXT_PUBLIC_NODE_ENV=development
